SECRET_KEY=change-me-to-a-long-random-secret
DATABASE_URL=sqlite:///docify.db
FLASK_DEBUG=1
# Required for Docker Compose; use a URL-safe random value.
POSTGRES_PASSWORD=change-me-to-a-random-password
REDIS_URL=redis://localhost:6379/0
# Optional: requires requirements/ai.txt and a pre-downloaded local model.
DOCIFY_SEMANTIC_SEARCH=false
# Optional bot integrations; never commit real credentials.
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_URL=
# Optional comma-separated CIDR ranges for direct clients; leave empty to disable.
ALLOWED_IPS=
# Production mode checks configuration, but does not make this prototype production-ready.
DOCIFY_ENV=development
SESSION_COOKIE_SECURE=false
RATELIMIT_STORAGE_URI=memory://
# Optional directory for the local semantic index (keep private and writable).
DOCIFY_FAISS_DIR=instance/faiss
DOCIFY_REDIS_SESSIONS=false
DOCIFY_FAQ_CACHE=false
# Optional response providers in priority order. Set the Gemini model with its key.
GEMINI_MODEL=
GEMINI_API_KEY=
OLLAMA_URL=
OLLAMA_MODEL=mistral
HF_MODEL_PATH=
SMTP_HOST=
SMTP_FROM=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
